# Domain Caddy gets an HTTPS certificate for (only used with `docker compose --profile https`).
# DOMAIN=linkmein.example.com

# Public URL of your Linkmein server (used for the LinkedIn OAuth redirect and cookies).
BASE_URL=http://localhost:3000
PORT=3000

# Self-hosted: where LinkedIn connections and the publish queue are kept.
# (Profiles, media and drafts live on each user's device, not here.)
DATA_DIR=./data

# Vercel (or any serverless host): a private Vercel Blob store instead of DATA_DIR.
# BLOB_READ_WRITE_TOKEN=

# Protects /api/cron/publish, which a cron service calls every minute on Vercel.
# CRON_SECRET=

# Encrypts LinkedIn tokens at rest and signs sessions. Self-hosted, one is generated in
# DATA_DIR/app-secret.key if unset. Required on Vercel.
# Back it up: losing it means users must re-enter their keys and reconnect LinkedIn.
# APP_SECRET=

# Your LinkedIn developer app (see README: "Create a LinkedIn app").
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Defaults to $BASE_URL/auth/linkedin/callback. Must match the app's Authorized redirect URL exactly.
# LINKEDIN_REDIRECT_URI=
# LinkedIn REST API version (YYYYMM). Defaults to two months ago.
# LINKEDIN_API_VERSION=

# Log posts instead of publishing them. Handy while you try things out.
LINKEDIN_DRY_RUN=false

# Show a "Continue as local dev user" button that skips LinkedIn sign-in. Never enable on a public server.
ALLOW_DEV_LOGIN=false

# Per-file limit for media attached to posts (defaults to 500, or 200 on Vercel).
# MAX_UPLOAD_MB=500
